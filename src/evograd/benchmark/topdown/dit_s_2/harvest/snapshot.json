        "rows": 9469,
        "pool_rule": "every Imagenette 320px train row: RGB, _crop to 256, mirrored iff sha256('dit-pool/flip/<row>')[0] is odd, VAE posterior mean + std * N(0, 1) drawn from torch.Generator('cpu').manual_seed(row), times 0.18215; encoded 8 rows at a time in float32",
        "rule": "data order o, step i: epoch e = i // (n // B) is torch.randperm(n) under the seed of 'dit/order<o>/epoch<e>'; the batch is its rows [(i mod (n // B)) * B, +B); noise ~ N(0, 1), timesteps ~ U{0..steps-1} and drop_mask ~ Bernoulli(class_dropout_prob) come from a generator under the seed of 'dit/order<o>/step<i>'"
      },
      "rule": "workload.train_batches(order).batch(0)"
    },
