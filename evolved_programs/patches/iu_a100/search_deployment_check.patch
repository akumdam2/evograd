+def _deployment_failure(op: OpDecl, module, *, device: str) -> str | None:
+    """Why the candidate's deployment entry does not run, or ``None``.
+
+    Gate 1 calls the pair directly and passes a backward only the scalars its
+    signature names; Gate 2, tier 2 and tier 3 call the deployment entry, which
+    passes every declared scalar. One untimed forward+backward through it at the
+    case's configuration (execution, shape, dtype and finiteness, as seed
+    acceptance checks it; no second numerical policy) keeps search feedback from
+    accepting a pair the final gates cannot call.
+    """
+    from evograd.evaluation.common.seed import _deployment_case
+
+    try:
+        _deployment_case(op, module, op.correctness[0], device, "benchmark_deployment")
+    except Exception as exc:
+        return f"deployment interface: {type(exc).__name__}: {exc}"
+    return None
+
+
