diff --git a/src/evograd/adbench_tools/gpu_lock.py b/src/evograd/adbench_tools/gpu_lock.py
new file mode 100644
index 0000000..16252b7
--- /dev/null
+++ b/src/evograd/adbench_tools/gpu_lock.py
@@ -0,0 +1,55 @@
+"""An optional cross-process lock around GPU evaluation (Gate 1 and T1 timing).
+
+Several ``bench.py run`` processes can search at once while only one of them
+evaluates on the GPU at any time. ``ADBENCH_GPU_LOCK`` names the lock file;
+when it is unset, :func:`gpu_lock` does nothing and the code behaves as before.
+
+Each acquire and release is written as one line to stderr and appended to
+``<lock>.log`` (stderr of an evaluation child is often captured), so waiting
+and holding times can be counted and overlaps ruled out afterwards.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import fcntl
+import os
+import sys
+import time
+
+LOCK_ENV = "ADBENCH_GPU_LOCK"
+
+
+def _log(path: str, line: str) -> None:
+    line = f"[gpu_lock] {line}\n"
+    sys.stderr.write(line)
+    sys.stderr.flush()
+    fd = os.open(path + ".log", os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
+    try:
+        os.write(fd, line.encode())
+    finally:
+        os.close(fd)
+
+
+@contextlib.contextmanager
+def gpu_lock(label: str):
+    """Hold ``$ADBENCH_GPU_LOCK`` exclusively for the body; a no-op when it is unset.
+
+    Never nest it: a child process that takes the lock while its parent holds it waits forever.
+    """
+    path = os.environ.get(LOCK_ENV)
+    if not path:
+        yield
+        return
+    with open(path, "a") as handle:
+        asked = time.time()
+        fcntl.flock(handle, fcntl.LOCK_EX)
+        held = time.time()
+        _log(path, f"acquire t={held:.3f} pid={os.getpid()} waited={held - asked:.3f} {label}")
+        try:
+            yield
+        finally:
+            released = time.time()
+            _log(path, f"release t={released:.3f} pid={os.getpid()} "
+                       f"held={released - held:.3f} {label}")
+            fcntl.flock(handle, fcntl.LOCK_UN)
