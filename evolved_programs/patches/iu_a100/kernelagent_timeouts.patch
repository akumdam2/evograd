+def _optimization_timeouts(seconds: int) -> None:
+    """Give optimization the test timeout generation gets (``--test-timeout``).
+
+    KernelAgent's optimization workers build their VerificationWorker and
+    KernelProfiler without a timeout, so its defaults apply: 30 s per test and
+    300 s per ncu run, sized for its own quick test. This test runs the
+    evaluator's Gate 1 on recorded payloads, and both wait for the shared GPU
+    lock. The workers are forked from this process and inherit the defaults.
+    """
+    import functools
+
+    from triton_kernel_agent import worker
+    from triton_kernel_agent.opt_worker_component.profiling import kernel_profiler
+
+    for cls, name in ((worker.VerificationWorker, "test_timeout_s"),
+                      (kernel_profiler.KernelProfiler, "ncu_timeout_seconds")):
+        init = cls.__init__
+
+        @functools.wraps(init)
+        def patched(self, *a, _init=init, _name=name, **k):
+            k.setdefault(_name, seconds)
+            _init(self, *a, **k)
+
+        cls.__init__ = patched
+
+
 def main(argv: list[str] | None = None) -> int:
     p = _common.parser(__doc__)
     p.add_argument("--kernelagent-root", type=Path, default=DEFAULT_ROOT)
