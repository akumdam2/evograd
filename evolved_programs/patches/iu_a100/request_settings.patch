+def _rewrite_request(body: bytes, min_output_tokens: int | None, default_reasoning: bool) -> bytes:
+    """``body`` brought to the trial's common request settings.
+
+    ``min_output_tokens``: an output cap (``max_completion_tokens``/``max_tokens``)
+    below it is raised to it. A reasoning model spends the cap on reasoning first,
+    so a cap an agent sized for visible output can end a request with nothing in it.
+    ``default_reasoning``: an agent's own ``reasoning_effort`` is dropped, so the
+    model runs at the API's default effort, as evograd's requests (which name none) do.
+    """
+    try:
+        request = json.loads(body)
+    except ValueError:
+        return body
+    if not isinstance(request, dict):
+        return body
+    changed = False
+    if min_output_tokens:
+        for key in ("max_completion_tokens", "max_tokens"):
+            value = request.get(key)
+            if isinstance(value, int) and not isinstance(value, bool) and value < min_output_tokens:
+                request[key], changed = min_output_tokens, True
+    if default_reasoning and "reasoning_effort" in request:
+        del request["reasoning_effort"]
+        changed = True
+    return json.dumps(request).encode() if changed else body
+
+
